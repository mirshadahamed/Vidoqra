{
    email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
    # Proxy API and WebSocket requests to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /ws/* {
        reverse_proxy backend:8000
    }
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }

    # Proxy frontend requests to Next.js runner
    handle {
        reverse_proxy frontend:3000
    }
}

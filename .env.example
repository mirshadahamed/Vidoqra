# ==========================================
# VIDOQRA ENVIRONMENT CONFIGURATION
# ==========================================

# Application Metadata & Debug
PROJECT_NAME="Vidoqra"
DEBUG=false
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Database Configuration (MongoDB Atlas or local)
# If left empty, Vidoqra will operate using high-performance local document store
MONGODB_URI="mongodb://localhost:27017/vidoqra"
MONGODB_DATABASE="vidoqra"

# Message Broker & Redis (for Celery and WebSocket PubSub)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Storage Settings
STORAGE_TYPE="local" # "local" or "s3"
LOCAL_STORAGE_DIR="./storage/media"
MAX_DOWNLOAD_SIZE_BYTES=2147483648 # 2 GB max per file
FILE_EXPIRY_HOURS=24

# S3 Compatible Object Storage (Optional for production)
S3_ENDPOINT_URL=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME=""
S3_REGION_NAME="us-east-1"

# Security & Secrets
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-key"
RATE_LIMIT_ANALYZE_PER_MINUTE=30
RATE_LIMIT_DOWNLOADS_PER_MINUTE=10

# System Tools
FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"

# Frontend Environment Variable
NEXT_PUBLIC_API_URL="http://localhost:8000"

